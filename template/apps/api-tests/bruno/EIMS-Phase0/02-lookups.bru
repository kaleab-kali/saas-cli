meta {
  name: EIMS Lookups
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/eims/lookups/document-types
  body: none
  auth: none
}

tests {
  test("returns versioned document type lookup data", function () {
    expect(res.status).to.equal(200);
    expect(res.body.version).to.equal("eims-lookup-seed-v3");
    expect(res.body.data.map((row) => row.code)).to.include("INV");
    expect(res.body.data.map((row) => row.code)).to.include("CRE");
  });
}
