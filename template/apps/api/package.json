{
	"name": "api",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"imports": {
		"#modules/*": "./src/modules/*",
		"#shared/*": "./src/shared/*"
	},
	"scripts": {
		"dev": "nest start --watch",
		"build": "nest build",
		"start": "node dist/src/main.js",
		"start:prod": "node dist/src/main.js",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "jest --runInBand",
		"test:unit": "jest --runInBand",
		"test:integration": "jest --config ./test/jest-e2e.json",
		"test:property": "jest --runTestsByPath src/modules/billing/application/services/policy.service.property.spec.ts src/modules/billing/domain/value-objects/billing.property.spec.ts src/shared/i18n/money.util.property.spec.ts --runInBand",
		"test:mutation": "stryker run",
		"test:coverage": "jest --coverage --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"db:generate": "prisma generate && node ../../scripts/trim-generated-prisma.mjs",
		"db:migrate": "prisma migrate dev",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"db:seed": "tsx prisma/seed.ts && tsx prisma/seed-plans.ts && tsx prisma/seed-platform-settings.ts && tsx prisma/seed-system-templates.ts && tsx prisma/seed-onboarding-templates.ts && tsx prisma/seed-sample-subscription.ts"
	},
	"dependencies": {
		"@nestjs/common": "11.1.19",
		"@nestjs/config": "4.0.4",
		"@nestjs/core": "11.1.19",
		"@nestjs/event-emitter": "3.0.1",
		"@nestjs/platform-express": "11.1.19",
		"@nestjs/platform-socket.io": "11.1.19",
		"@nestjs/schedule": "6.1.3",
		"@nestjs/swagger": "11.3.0",
		"@nestjs/terminus": "11.1.1",
		"@nestjs/throttler": "6.5.0",
		"@nestjs/websockets": "11.1.19",
		"@paralleldrive/cuid2": "3.3.0",
		"@prisma/adapter-pg": "7.8.0",
		"@prisma/client": "7.8.0",
		"@thallesp/nestjs-better-auth": "2.6.0",
		"@types/nodemailer": "8.0.0",
		"@types/pdfkit": "0.17.6",
		"better-auth": "1.6.11",
		"bullmq": "5.77.3",
		"class-transformer": "0.5.1",
		"class-validator": "0.15.1",
		"compression": "1.8.1",
		"cookie-parser": "1.4.7",
		"exceljs": "4.4.0",
		"helmet": "8.1.0",
		"ioredis": "5.10.1",
		"multer": "2.1.1",
		"nestjs-pino": "4.6.1",
		"nodemailer": "8.0.5",
		"pdfkit": "0.18.0",
		"pg": "8.20.0",
		"pino": "10.3.1",
		"pino-http": "11.0.0",
		"pino-roll": "4.0.0",
		"pino-telegram": "3.2.0",
		"prom-client": "15.1.3",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"socket.io": "4.8.3",
		"stripe": "22.1.0"
	},
	"devDependencies": {
		"@nestjs/cli": "11.0.21",
		"@nestjs/schematics": "11.0.10",
		"@nestjs/testing": "11.1.19",
		"@stryker-mutator/core": "9.6.1",
		"@stryker-mutator/jest-runner": "9.6.1",
		"@types/compression": "1.8.1",
		"@types/cookie-parser": "1.4.10",
		"@types/express": "5.0.6",
		"@types/jest": "30.0.0",
		"@types/multer": "2.1.0",
		"@types/node": "24.12.2",
		"@types/supertest": "6.0.3",
		"dotenv": "17.4.2",
		"fast-check": "4.8.0",
		"jest": "30.3.0",
		"pino-pretty": "13.1.3",
		"prisma": "7.8.0",
		"source-map-support": "0.5.21",
		"supertest": "7.2.2",
		"ts-jest": "29.4.9",
		"ts-loader": "9.5.7",
		"ts-node": "10.9.2",
		"tsconfig-paths": "4.2.0",
		"tsx": "4.21.0",
		"typescript": "5.9.3",
		"zod": "4.3.6"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s",
			"!generated/**",
			"!**/*.module.ts",
			"!**/*.dto.ts",
			"!**/*.entity.ts",
			"!**/*.events.ts",
			"!**/*.repository.ts",
			"!**/presentation/**",
			"!**/infrastructure/mappers/**",
			"!main.ts"
		],
		"coveragePathIgnorePatterns": [
			"/node_modules/",
			"/generated/",
			"/dist/"
		],
		"coverageThreshold": {
			"global": {
				"statements": 5,
				"branches": 4,
				"functions": 5,
				"lines": 5
			},
			"src/modules/billing/application/services/policy.service.ts": {
				"statements": 100,
				"branches": 100,
				"functions": 100,
				"lines": 100
			},
			"src/modules/onboarding/application/onboarding.service.ts": {
				"statements": 70,
				"branches": 55,
				"functions": 65,
				"lines": 75
			},
			"src/modules/auth/guards/permissions.guard.ts": {
				"statements": 95,
				"branches": 85,
				"functions": 100,
				"lines": 95
			},
			"src/shared/filters/global-exception.filter.ts": {
				"statements": 95,
				"branches": 75,
				"functions": 100,
				"lines": 95
			},
			"src/shared/interceptors/audit.interceptor.ts": {
				"statements": 95,
				"branches": 75,
				"functions": 100,
				"lines": 95
			},
			"src/shared/crypto/cipher.service.ts": {
				"statements": 85,
				"branches": 80,
				"functions": 100,
				"lines": 85
			},
			"src/shared/rate-limit/tenant-throttler.guard.ts": {
				"statements": 85,
				"branches": 75,
				"functions": 90,
				"lines": 85
			}
		},
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
