NODE_ENV=development
APP_NAME={{projectName}}

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{dbName}}

# --- Redis ---
REDIS_URL=redis://localhost:6379
BULLMQ_QUEUES=billing,notifications,reports
BULLMQ_PREFIX=

# --- Better Auth ---
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
MASTER_KEY=change-me-generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_PER_TENANT=60
API_RATE_LIMIT_BLOCK_MS=60000
METRICS_TOKEN=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@{{caddyDomain}}

# --- Uploads ---
UPLOAD_MAX_BYTES=10485760
# local stores files under apps/api/uploads. object uses S3-compatible self-hosted storage such as MinIO.
STORAGE_DRIVER=local
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET={{projectSlug}}
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_URL=

# --- Logging ---
LOG_LEVEL=debug
SLOW_QUERY_THRESHOLD_MS=200


# --- Super Admin (seed) ---
SUPER_ADMIN_EMAIL={{superAdminEmail}}
SUPER_ADMIN_PASSWORD={{superAdminPassword}}
SUPER_ADMIN_NAME=Platform Admin
# Set after running seed - contains the superadmin user ID
# SUPER_ADMIN_USER_IDS=user_id_here

# --- Telegram Alerts (optional) ---
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id
