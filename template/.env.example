# ===========================================
# PropFlow — All Environment Variables Reference
# ===========================================
# This file is DOCUMENTATION ONLY. It is NOT loaded by any app.
# Actual env files live in each app folder:
#   - apps/api/.env  (NestJS backend)
#   - apps/web/.env  (Vite frontend)
# Copy the relevant .env.example in each app folder.
# ===========================================

# ===================== API (apps/api/.env) =====================

NODE_ENV=development

# --- Database ---
DATABASE_URL=postgresql://propflow:propflow@localhost:5432/propflow

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Better Auth ---
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0

# --- Logging ---
LOG_LEVEL=debug
# LOG_LEVEL=info  # Use in production
SLOW_QUERY_THRESHOLD_MS=200

# --- Telegram Alerts (optional, production) ---
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# --- Production Only ---
# DOMAIN=propflow.yourdomain.com
# BETTER_AUTH_URL=https://propflow.yourdomain.com
# FRONTEND_URL=https://propflow.yourdomain.com

# ===================== WEB (apps/web/.env) =====================

VITE_API_URL=http://localhost:3000
VITE_APP_NAME=PropFlow
