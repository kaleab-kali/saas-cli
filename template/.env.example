# {{projectName}} - All Environment Variables Reference
# This file is documentation only. Runtime env files live in:
# - apps/api/.env
# - apps/web/.env

# ===================== API (apps/api/.env) =====================

NODE_ENV=development
APP_NAME={{projectName}}

# --- Database ---
DATABASE_URL=postgresql://{{projectSlug}}:{{projectSlug}}@localhost:5432/{{dbName}}

# --- Redis ---
REDIS_URL=redis://localhost:6379
BULLMQ_QUEUES=billing,notifications,reports
BULLMQ_PREFIX=

# --- Better Auth ---
BETTER_AUTH_SECRET=GENERATE_WITH_openssl_rand_hex_32
MASTER_KEY=GENERATE_WITH_openssl_rand_hex_32
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- Super Admin (seed) ---
SUPER_ADMIN_EMAIL={{superAdminEmail}}
SUPER_ADMIN_PASSWORD={{superAdminPassword}}
SUPER_ADMIN_NAME=Platform Admin

# --- API ---
API_PORT=3000
API_HOST=0.0.0.0
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_PER_TENANT=60
API_RATE_LIMIT_BLOCK_MS=60000
METRICS_TOKEN=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@{{caddyDomain}}

# --- Uploads ---
UPLOAD_MAX_BYTES=10485760
# local stores files under apps/api/uploads. object uses S3-compatible self-hosted storage such as MinIO.
STORAGE_DRIVER=local
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET={{projectSlug}}
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_URL=

# --- Logging ---
LOG_LEVEL=debug
SLOW_QUERY_THRESHOLD_MS=200

# --- Stripe (optional billing gateway) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Chapa (optional billing gateway) ---
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_CALLBACK_BASE_URL=


# --- Production ---
# DOMAIN={{caddyDomain}}
# BETTER_AUTH_URL=https://{{caddyDomain}}
# FRONTEND_URL=https://{{caddyDomain}}

# ===================== WEB (apps/web/.env) =====================

VITE_API_URL=http://localhost:3000
VITE_APP_NAME={{projectName}}
