# ===========================================
# {{projectName}} Production Environment
# ===========================================
# Copy to .env on your VPS. Fill in real values.
# ===========================================

NODE_ENV=production

# --- Database ---
DATABASE_URL=postgresql://{{projectSlug}}:STRONG_PASSWORD_HERE@localhost:5432/{{dbName}}

# --- Redis ---
REDIS_URL=redis://localhost:6379
BULLMQ_QUEUES=billing,notifications,reports
BULLMQ_PREFIX=

# --- Better Auth ---
BETTER_AUTH_SECRET=GENERATE_WITH_openssl_rand_base64_32
BETTER_AUTH_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# --- API ---
API_PORT=3000
API_HOST=127.0.0.1

# --- Uploads ---
UPLOAD_MAX_BYTES=10485760
STORAGE_DRIVER=local
# For self-hosted object storage, set STORAGE_DRIVER=object and point these at MinIO/Garage/SeaweedFS.
OBJECT_STORAGE_ENDPOINT=https://objects.your-domain.com
OBJECT_STORAGE_BUCKET={{projectSlug}}
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_URL=

# --- EIMS / Ethiopian e-invoicing ---
EIMS_ENV=production
EIMS_MOCK_MODE=false
EIMS_BASE_URL_SANDBOX=
EIMS_BASE_URL_PRODUCTION=
EIMS_BULK_URL_SANDBOX=
EIMS_BULK_URL_PRODUCTION=
EIMS_SIGNING_PROVIDER=vault
EIMS_CANONICALIZATION_VERSION=phase0-unlocked
EIMS_PHASE0_STRICT=true
EIMS_CALLBACK_PUBLIC_URL=
EIMS_LOOKUP_CACHE_TTL_SECONDS=300

# --- Domain ---
DOMAIN=your-domain.com
