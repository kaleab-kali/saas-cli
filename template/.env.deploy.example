# {{projectName}} deployment runner settings
# Copy to .env.deploy.staging or .env.deploy.production on the machine that runs pnpm deploy.

DEPLOY_HOST=your-vps.example.com
DEPLOY_USER=deploy
DEPLOY_SSH_PORT=22
DEPLOY_PATH=/var/www/{{projectSlug}}
DEPLOY_BRANCH=main
DEPLOY_PM2_APP={{projectSlug}}-api
DEPLOY_HEALTH_URL=http://127.0.0.1:3000/health
DEPLOY_KEEP_RELEASES=5
DEPLOY_BACKUP_RETENTION_DAYS=35
