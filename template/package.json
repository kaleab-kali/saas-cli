{
	"name": "{{projectSlug}}",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"doctor": "node scripts/doctor.mjs",
		"doctor:production": "node scripts/doctor.mjs --production",
		"deploy:check": "pnpm db:generate && pnpm doctor:production && pnpm test:security:tooling:strict && pnpm test:performance:tooling:strict && pnpm lint && pnpm typecheck && pnpm build:api && pnpm build:web && pnpm test:smoke",
		"gen:module": "create-vyllion-saas add module",
		"gen:starter": "create-vyllion-saas add starter",
		"dev:test": "turbo dev --filter api --filter web",
		"typecheck:api": "pnpm --filter api exec tsc --noEmit",
		"typecheck:web": "pnpm --filter web exec tsc --noEmit",
		"typecheck": "pnpm typecheck:api && pnpm typecheck:web",
		"test:api": "pnpm --filter api test",
		"test:api:e2e": "pnpm --filter api test:e2e",
		"test:api:http": "pnpm --filter api-tests test:http",
		"test:api:http:mock": "pnpm --filter api-tests test:http:mock",
		"test:api:bruno": "pnpm --filter api-tests test:bruno",
		"test:api:bruno:mock": "pnpm --filter api-tests test:bruno:mock",
		"test:api:contract": "pnpm --filter api-tests test:contract",
		"test:api:contract:smoke": "pnpm --filter api-tests test:contract:smoke",
		"test:e2e": "pnpm --filter e2e test",
		"test:e2e:smoke": "pnpm --filter e2e test:smoke",
		"test:web:e2e": "pnpm test:e2e",
		"test:acceptance": "pnpm --filter acceptance test",
		"test:acceptance:dry": "pnpm --filter acceptance test:dry",
		"test:load": "pnpm --filter performance test:k6",
		"test:load:k6": "pnpm --filter performance test:k6",
		"test:load:k6:api": "pnpm --filter performance test:k6:api",
		"test:load:k6:mock": "pnpm --filter performance test:k6:mock",
		"test:performance:tooling:strict": "pnpm --filter performance test:k6:strict",
		"test:performance": "pnpm --filter performance test",
		"test:ai": "pnpm --filter ai-eval test",
		"test:security": "pnpm --filter security test",
		"test:security:secrets": "pnpm --filter security test:secrets",
		"test:security:deps": "pnpm --filter security test:deps",
		"test:security:sast": "pnpm --filter security test:sast",
		"test:security:http": "pnpm --filter security test:http",
		"test:security:api": "pnpm --filter security test:api",
		"test:security:source": "pnpm --filter security test:source",
		"test:security:tooling": "pnpm --filter security test:tooling",
		"test:security:tooling:strict": "pnpm --filter security test:tooling:strict",
		"test:unit": "pnpm test:api",
		"test:integration": "pnpm test:api:e2e && pnpm test:api:http:mock && pnpm test:api:contract:smoke",
		"test:property": "pnpm --filter api test:property",
		"test:mutation": "pnpm --filter api test:mutation",
		"test:coverage": "pnpm --filter api test:coverage",
		"test:smoke": "pnpm typecheck && pnpm test:api && pnpm test:property && pnpm test:api:http:mock && pnpm test:api:bruno:mock && pnpm test:api:contract && pnpm test:e2e:smoke && pnpm test:acceptance && pnpm test:load:k6:mock && pnpm test:security:source && pnpm test:security:api && pnpm test:security:tooling && pnpm test:ai",
		"test:ci": "pnpm db:generate && pnpm typecheck && pnpm test:api && pnpm test:property && pnpm test:api:http:mock && pnpm test:api:bruno:mock && pnpm test:api:contract && pnpm test:acceptance && pnpm test:security:source && pnpm test:security:api && pnpm test:security:tooling && pnpm test:ai",
		"test:all": "pnpm db:generate && pnpm typecheck && pnpm lint && pnpm test:api && pnpm test:property && pnpm test:mutation && pnpm test:api:http:mock && pnpm test:api:bruno:mock && pnpm test:api:contract && pnpm test:e2e:smoke && pnpm test:acceptance && pnpm test:performance && pnpm test:security && pnpm test:ai",
		"test:full": "pnpm test:all",
		"lint:ci": "pnpm db:generate && pnpm lint && pnpm typecheck",
		"dev:api": "pnpm --filter api dev",
		"dev:web": "pnpm --filter web dev",
		"build:api": "pnpm --filter api build",
		"build:web": "pnpm --filter web build",
		"db:generate": "pnpm --filter api db:generate",
		"db:migrate": "pnpm --filter api db:migrate",
		"db:push": "pnpm --filter api db:push",
		"db:backup": "node scripts/backup-postgres.mjs",
		"db:restore": "node scripts/restore-postgres.mjs",
		"db:studio": "pnpm --filter api db:studio",
		"db:seed": "pnpm --filter api db:seed",
		"pm2:start": "pm2 start ecosystem.config.cjs",
		"pm2:stop": "pm2 stop ecosystem.config.cjs",
		"pm2:restart": "pm2 restart ecosystem.config.cjs",
		"pm2:logs": "pm2 logs",
		"gen:starters": "create-vyllion-saas list starters",
		"gen:starter:uninstall": "create-vyllion-saas remove starter"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.12",
		"lefthook": "2.1.5",
		"turbo": "2.9.14"
	},
	"pnpm": {
		"overrides": {
			"@hono/node-server": "1.19.13",
			"axios": "1.16.0",
			"brace-expansion": "5.0.6",
			"fast-uri": "3.1.2",
			"hono": "4.12.18",
			"ip-address": "10.1.1",
			"kysely": "0.28.17",
			"qs": "6.15.2",
			"tmp": "0.2.6",
			"uuid": "11.1.1",
			"ws": "8.20.1"
		}
	},
	"packageManager": "pnpm@9.15.0",
	"engines": {
		"node": ">=20.0.0"
	}
}
