meta {
  name: EIMS Receipts
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/eims/receipts
  body: none
  auth: none
}

tests {
  test("returns sales receipt linked to an invoice IRN", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data[0].status).to.equal("accepted");
    expect(res.body.data[0].invoiceIrn).to.match(/^TEST-IRN-/);
    expect(res.body.data[0].rrn).to.match(/^TEST-RRN-/);
  });
}
