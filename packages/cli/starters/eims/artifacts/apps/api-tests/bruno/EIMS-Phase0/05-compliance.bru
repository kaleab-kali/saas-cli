meta {
  name: EIMS Compliance Evidence
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/eims/compliance/evidence
  body: none
  auth: none
}

tests {
  test("returns compliance evidence readiness", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.readiness).to.be.greaterThan(50);
    const keys = res.body.data.items.map((item) => item.key);
    expect(keys).to.include("invoices");
    expect(keys).to.include("receipts");
    expect(keys).to.include("cancellations");
  });
}
